# OpsOne 的 nginx 反代样例（只有在需要 HTTPS 或与其它站点共用 80/443 时才需要它）。
#
# 后端配了 OPS_WEB_DIR 时会自己托管前端，nginx 只做 TLS 卸载 + 转发即可，
# 不用再单独配前端 root 与 SPA 回落。
#
# 两个容易踩的点：
#   1. Web 终端、集群服务转发都是 WebSocket，必须转发 Upgrade / Connection 头；
#   2. 终端是长连接，proxy_read_timeout 必须放大，默认 60s 会把闲置的终端踢断。

upstream opsone {
    server 127.0.0.1:8080;
    keepalive 32;
}

server {
    listen 80;
    server_name ops.example.com;
    # 内网自用也建议上 TLS：登录口令与终端内容都走这条链路
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ops.example.com;

    ssl_certificate     /etc/nginx/ssl/ops.example.com.crt;
    ssl_certificate_key /etc/nginx/ssl/ops.example.com.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # 主机 CSV 导入、SFTP 上传要传文件；上限跟平台里的「上传上限」配置对齐
    client_max_body_size 512m;

    # 探活（不带鉴权，只回状态）
    location = /healthz { proxy_pass http://opsone; access_log off; }
    location = /readyz  { proxy_pass http://opsone; access_log off; }

    location / {
        proxy_pass http://opsone;
        proxy_http_version 1.1;

        # WebSocket：Web 终端（/api/v1/hosts/:id/terminal）与录像回放都要用
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # 平台默认忽略这个头，要让审计记录真实客户端 IP，
        # 需要把 nginx 的地址填进 OPS_TRUSTED_PROXIES。
        #
        # 注意两件事：
        #   1) $proxy_add_x_forwarded_for 会把客户端自己带的 XFF 拼在前面 ——
        #      客户端因此可以伪造更靠前的地址。不信任客户端就改成：
        #        proxy_set_header X-Forwarded-For $remote_addr;
        #   2) 反代与平台同机时 OPS_TRUSTED_PROXIES 只能写 127.0.0.1，
        #      这等于信任本机所有进程都能伪造来源 IP（已验证）。
        #      配合 OPS_ADDR=127.0.0.1:8080 只监听本机，能把影响面收在本机内。
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 终端会长时间没有数据流动，超时给足
        proxy_connect_timeout 10s;
        proxy_send_timeout    3600s;
        proxy_read_timeout    3600s;

        # 批量执行是同步请求，输出要等命令跑完，别让 nginx 提前缓冲/截断
        proxy_buffering off;
    }
}

# 放在 http {} 里（或 conf.d 外层）：Connection 头要根据 Upgrade 动态给
# map $http_upgrade $connection_upgrade {
#     default upgrade;
#     ''      close;
# }
