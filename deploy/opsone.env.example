# OpsOne 运行配置样例。
# systemd 部署：拷到 /etc/opsone/opsone.env，权限给 root:opsone 0640
#   （0600 会让以服务账号身份跑的 `ops backup --env-file` 读不到）
# docker compose 部署：拷成仓库根目录的 .env
#
# 标了「必改」的三项在 OPS_ENV=prod 下不改就启动失败，这是故意的。

# ---------- 基本 ----------
# dev：宽松，只打 warn；prod：不安全的配置直接拒绝启动
OPS_ENV=prod
OPS_ADDR=:8080
# 数据库、录像、备份的落盘位置（systemd 部署建议放 /var/lib/opsone 下）
OPS_DSN=/var/lib/opsone/ops.db
OPS_RECORD_DIR=/var/lib/opsone/recordings
OPS_BACKUP_DIR=/var/lib/opsone/backups
# 前端构建产物目录。配了它后端就直接托管前端，不用再配 nginx
OPS_WEB_DIR=/var/lib/opsone/web

# ---------- 必改 ----------
# 必改 1：JWT 签名密钥，32 字节以上随机串。生成：openssl rand -base64 48
OPS_JWT_SECRET=
# 必改 2：内置 admin 的初始口令（只在首次初始化时用，登录后请立刻改）
OPS_ADMIN_PASSWORD=
# 必改 3：允许的前端来源，同时是 WebSocket 的 Origin 白名单。多个用逗号分隔
OPS_ALLOW_ORIGINS=https://ops.example.com

# ---------- 建议 ----------
# 反向代理的地址（nginx 所在 IP / CIDR）。留空表示不信任任何代理：
# X-Forwarded-For 会被忽略，审计里记的就是反代的 IP
OPS_TRUSTED_PROXIES=127.0.0.1
# 令牌有效期（小时）
OPS_TOKEN_TTL_HOUR=12
# SQL 日志与 gin 调试模式，prod 下必须是 false
OPS_DEBUG=false
# SSH 主机指纹校验：首次连接记录（TOFU），之后变了就拒连
OPS_SSH_STRICT_HOST_KEY=true
# 优雅退出等待上限（秒）。批量执行是同步请求，给小了会把作业截断
OPS_SHUTDOWN_TIMEOUT_SEC=30

# ---------- 备份（默认已开）----------
# 备份先于数据留存清理（03:30）执行，清理是真删且不可逆
OPS_BACKUP_SPEC=0 3 * * *
OPS_BACKUP_KEEP=7

# ---------- 定时任务节奏（留空即关闭该项）----------
OPS_CERT_CHECK_SPEC=0 8 * * *
OPS_ALERT_RULE_SPEC=*/5 * * * *
OPS_PROBE_SPEC=*/5 * * * *
OPS_RETENTION_SPEC=30 3 * * *
OPS_DETECTION_SPEC=*/5 * * * *
OPS_KUBE_CHECK_SPEC=*/5 * * * *
OPS_HOST_METRIC_SPEC=*/5 * * * *
OPS_ONCALL_SPEC=* * * * *
OPS_EXPOSURE_SPEC=20 4 * * *

# ---------- 集群服务转发 ----------
# 隧道本身不做认证，能连到端口的人等同于能访问被转发的服务（docs/SECURITY.md 16）
OPS_FORWARD_BIND=127.0.0.1
OPS_FORWARD_PORT_MIN=30000
OPS_FORWARD_PORT_MAX=30099
OPS_FORWARD_MAX=8
OPS_FORWARD_TTL_MINUTES=120
OPS_FORWARD_CONN_MAX=32
